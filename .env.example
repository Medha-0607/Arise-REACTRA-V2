# =============================================================================
# REACTRA V2 — Environment Configuration Template (.env.example)
# Copy this file to .env and configure appropriate values for your deployment.
# =============================================================================

# Application Environment (development, testing, production)
REACTRA_ENV=development
REACTRA_DEBUG=true

# Security Key (Generate a cryptographically secure random string in production)
REACTRA_SECRET_KEY=change-this-insecure-secret-key-for-production-deployment

# Database Connection (SQLite default for offline field operation)
REACTRA_DATABASE_URL=sqlite:///./data/reactra_v2.db

# Device Enrollment Identifier
DEVICE_ENROLLMENT_ID=DEV-FIELD-UNIT-01
