# =============================================================================
# REACTRA V2 — Official .gitignore (SIH 2026 Submission)
# =============================================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/
backend/env/
develop-eggs/
dist/
/build/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment & Secret Protection
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials/

# Node / Frontend Build & Modules
node_modules/
frontend/node_modules/
dist/
frontend/dist/
build/
frontend/build/
.vite/
frontend/.vite/
frontend/.env.local
frontend/.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Runtime Generated Storage
*.sqlite
*.sqlite3
*.db
backend/data/*.db
data/*.db
data/local/*.db
data/
backend/data/
storage/
backend/storage/

# IDE & Operating System
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Temporary Logs & Scratch
tmp/
temp/
*.log
.tempmediaStorage/
